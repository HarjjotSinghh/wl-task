{% schema %}
{
  "name": "Vendor collection",
  "tag": "section",
  "class": "section-vendor-collection",
  "enabled_on": {
    "templates": ["product", "index"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "On product pages, shows when a collection title exactly matches the product vendor. On the homepage, pick a collection below to preview the Figma section."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection override"
    },
    {
      "type": "text",

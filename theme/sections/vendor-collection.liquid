{% comment %}
  Vendor collection: Liquid matches collection.title to product.vendor (or a
  theme-editor override), then serializes JSON. React mounts on
  [data-wl-vendor-root]. No match → this file outputs nothing.
{% endcomment %}
{% style %}
  #shopify-section-{{ section.id }} {
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .wl-vc h2.wl-vc__more-title {
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .wl-vc h3.wl-vc__card-title {
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-weight: 700;
    font-style: normal;
    font-size: 16px;
    line-height: 22px;
    letter-spacing: 0;
    color: #000;
    text-wrap: pretty;
    text-wrap: balance;
  }
  #shopify-section-{{ section.id }} .wl-vc h2.wl-vc__title {
    font-family: "Playfair Display", Georgia, "Times New Roman", serif;
    font-weight: 600;
    font-style: normal;
    letter-spacing: 0;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__kicker {
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
    letter-spacing: 0;
  }
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__view-all,
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__atc,
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__card-meta,
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__rating,
  #shopify-section-{{ section.id }} .wl-vc .wl-vc__body {
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .wl-vc h2.wl-vc__more-title {
      font-size: 18px;
      line-height: 24px;
    }
    #shopify-section-{{ section.id }} .wl-vc h3.wl-vc__card-title {
      font-size: 19.1px;
      line-height: 27px;
      text-wrap: pretty;
      text-wrap: balance;
    }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .wl-vc h2.wl-vc__title {
      font-size: 32px;
      line-height: 36px;
    }
  }
{% endstyle %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">

{%- liquid
  assign brand_collection = nil

  # Homepage can pin a collection. On PDPs, match vendor to collection title:
  # handle lookup first, then a title scan if the handle does not match.
  if section.settings.collection != blank
    assign brand_collection = section.settings.collection
  elsif product != blank
    assign vendor_key = product.vendor | strip
    if vendor_key != blank
      assign vendor_handle = vendor_key | handleize
      assign candidate = collections[vendor_handle]
      if candidate != blank and candidate.title == vendor_key
        assign brand_collection = candidate
      else
        for col in collections
          if col.title == vendor_key
            assign brand_collection = col
            break
          endif
        endfor
      endif
    endif
  endif

  assign kicker = section.settings.kicker
  if kicker == blank
    assign kicker = 'vendor_collection.kicker' | t
  endif

  assign more_title = ''
  if brand_collection != blank
    assign more_title = brand_collection.title | split: ' by ' | first | upcase
  endif
  assign more_from_label = 'vendor_collection.more_from' | t: title: more_title

  # Hide More From when the collection has 0 or 1 products.
  assign exclude_current = section.settings.exclude_current_product
  assign show_more = false
  if brand_collection != blank and brand_collection.all_products_count >= 2
    assign show_more = true
  endif

  assign has_image = false
  if brand_collection != blank and brand_collection.image != blank
    assign has_image = true
  endif

  assign has_description = false
  if brand_collection != blank
    assign desc_plain = brand_collection.description | strip
    if desc_plain != blank
      assign has_description = true
    endif
  endif
-%}

{%- if brand_collection != blank -%}
  <section
    class="wl-vendor-section"
    id="VendorCollection-{{ section.id }}"
    data-section-id="{{ section.id }}"
  >
    <div data-wl-vendor-root>
      {% comment %} Payload for the React island. Nulls omit image/description. {% endcomment %}
      <script type="application/json">
        {
          "showMoreFrom": {{ show_more | json }},
          "labels": {
            "kicker": {{ kicker | json }},
            "moreFrom": {{ more_from_label | json }},
            "viewAll": {{ 'vendor_collection.view_all' | t | json }},
            "addToCart": {{ 'vendor_collection.add_to_cart' | t | json }},
            "adding": {{ 'vendor_collection.adding' | t | json }},
            "addError": {{ 'vendor_collection.add_error' | t | json }},
            "reviews": {{ 'vendor_collection.reviews' | t | json }},
            "prev": {{ 'vendor_collection.previous' | t | json }},
            "next": {{ 'vendor_collection.next' | t | json }}
          },
          "collection": {
            "id": {{ brand_collection.id | json }},
            "title": {{ brand_collection.title | json }},
            "titleUpper": {{ brand_collection.title | upcase | json }},
            "url": {{ brand_collection.url | json }},
            "image": {% if has_image %}{{ brand_collection.image | image_url: width: 1600 | json }}{% else %}null{% endif %},
            "imageAlt": {% if has_image %}{{ brand_collection.image.alt | default: brand_collection.title | json }}{% else %}null{% endif %},
            "descriptionHtml": {% if has_description %}{{ brand_collection.description | json }}{% else %}null{% endif %}
          },
          "products": [
            {%- assign listed = 0 -%}
            {%- for item in brand_collection.products -%}
              {%- if exclude_current and item.id == product.id -%}
                {%- continue -%}
              {%- endif -%}
              {%- assign rating = item.metafields.custom.rating.value -%}
              {%- assign review_count = item.metafields.custom.review_count.value -%}
              {%- if rating == blank and item.metafields.reviews.rating.value != blank -%}
                {%- assign rating = item.metafields.reviews.rating.value.rating -%}
              {%- endif -%}
              {%- if review_count == blank and item.metafields.reviews.rating_count.value != blank -%}
                {%- assign review_count = item.metafields.reviews.rating_count.value -%}
              {%- endif -%}
              {%- assign bottle_size = item.metafields.custom.bottle_size.value | default: '750ml' -%}
              {%- assign abv = item.metafields.custom.abv.value -%}
              {%- assign variant = item.selected_or_first_available_variant -%}
              {%- unless listed == 0 -%},{%- endunless -%}
              {
                "id": {{ item.id | json }},
                "title": {{ item.title | json }},
                "url": {{ item.url | json }},
                "image": {% if item.featured_image %}{{ item.featured_image | image_url: width: 800 | json }}{% else %}null{% endif %},
                "imageAlt": {{ item.featured_image.alt | default: item.title | json }},
                "price": {{ variant.price | money | json }},
                "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                "onSale": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
                "variantId": {{ variant.id | json }},
                "available": {{ variant.available | json }},
                "size": {{ bottle_size | json }},
                "abv": {{ abv | json }},
                "rating": {{ rating | json }},
                "reviewCount": {{ review_count | json }}
              }
              {%- assign listed = listed | plus: 1 -%}
            {%- endfor -%}
          ]
        }
      </script>
    </div>
  </section>
  <script src="{{ 'vendor-collection.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

